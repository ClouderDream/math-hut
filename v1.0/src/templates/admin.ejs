<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>后台管理 · <%= site.title %></title>
<link rel="icon" href="<%= u('assets/img/favicon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%= u('assets/css/main.css') %>?v=<%= v %>">
<link rel="stylesheet" href="<%= u('assets/css/code.css') %>?v=<%= v %>">
<link rel="stylesheet" href="<%= u('admin/vendor/katex.min.css') %>?v=<%= v %>">
<script>
(function(){try{var t=localStorage.getItem('theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
</script>
</head>
<body class="admin-body">

<!-- ============ 登录 ============ -->
<section class="admin-login" id="loginView">
  <form class="login-card" id="loginForm">
    <h1 class="login-title"><%= site.title %> · 后台</h1>
    <p class="login-desc">输入管理口令与 GitHub Token 进入。凭证只保存在你自己的浏览器里，不会上传任何服务器。</p>

    <label class="field">
      <span>管理口令</span>
      <input type="password" id="passInput" placeholder="你设置的口令" autocomplete="current-password" required>
    </label>

    <label class="field">
      <span>GitHub Token（PAT）</span>
      <input type="password" id="tokenInput" placeholder="github_pat_..." autocomplete="off" required>
    </label>

    <label class="checkbox">
      <input type="checkbox" id="remember"> 记住 Token（公用电脑不要勾）
    </label>

    <button class="btn primary block" type="submit" id="loginBtn">进入后台</button>

    <p class="login-error" id="loginError" hidden></p>

    <details class="login-help">
      <summary>怎么拿到 GitHub Token？</summary>
      <ol>
        <li>打开 <a href="https://github.com/settings/personal-access-tokens" target="_blank" rel="noopener">github.com/settings/personal-access-tokens</a></li>
        <li>点 <strong>Generate new token</strong>（选 Fine-grained token）</li>
        <li>Token name 随意；Expiration 建议 90 天</li>
        <li>Repository access 选 <strong>Only select repositories</strong> → 勾 <code><%= cfg.admin.repo %></code></li>
        <li>Permissions → Repository permissions → 把 <strong>Contents</strong> 设为 <strong>Read and write</strong></li>
        <li>生成后复制那串 <code>github_pat_...</code>，粘贴到上面</li>
      </ol>
      <p class="warn">⚠️ 这串 Token 等同于仓库的写权限。泄露请立刻到同一页面 Revoke。</p>
    </details>

    <p class="login-back"><a href="<%= u('/') %>">← 返回站点</a></p>
  </form>
</section>

<!-- ============ 后台主体 ============ -->
<section class="admin-app" id="appView" hidden>
  <aside class="admin-side">
    <div class="admin-side-head">
      <strong>文章列表</strong>
      <button class="btn sm" id="newBtn" type="button">＋ 新建</button>
    </div>
    <p class="admin-side-meta" id="repoInfo"></p>
    <ul class="admin-list" id="postList"><li class="admin-loading">加载中…</li></ul>
    <div class="admin-side-foot">
      <button class="btn sm ghost block" id="logoutBtn" type="button">退出并清除 Token</button>
    </div>
  </aside>

  <main class="admin-main">
    <div class="admin-bar">
      <input class="admin-title-input" id="fTitle" placeholder="文章标题" autocomplete="off">
      <button class="btn primary sm" id="saveBtn" type="button">保存并发布</button>
      <button class="btn danger sm" id="deleteBtn" type="button">删除</button>
    </div>

    <div class="admin-meta">
      <label class="field inline"><span>日期</span><input id="fDate" type="date"></label>
      <label class="field inline"><span>slug（URL）</span><input id="fSlug" placeholder="limit-and-derivative" autocomplete="off"></label>
      <label class="field inline"><span>标签（逗号分隔）</span><input id="fTags" placeholder="微积分, 数学分析" autocomplete="off"></label>
      <label class="field inline grow"><span>摘要</span><input id="fSummary" placeholder="一句话概括这篇文章" autocomplete="off"></label>
      <label class="checkbox inline"><input type="checkbox" id="fDraft"> 草稿</label>
    </div>

    <div class="admin-editor">
      <div class="editor-pane">
        <div class="pane-head">Markdown 源码</div>
        <textarea id="fBody" spellcheck="false" placeholder="在此书写 Markdown。行内公式 $E=mc^2$，行间公式另起一行 $$ ... $$"></textarea>
      </div>
      <div class="editor-pane">
        <div class="pane-head">实时预览<span class="pane-tip" id="previewTip"></span></div>
        <div class="preview" id="preview"></div>
      </div>
    </div>

    <p class="admin-status" id="status"></p>
  </main>
</section>

<script src="<%= u('admin/vendor/markdown-it.min.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/vendor/katex.min.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/vendor/md-math.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/config.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/github.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/admin.js') %>?v=<%= v %>"></script>
</body>
</html>
