<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>后台管理 · <%= site.title %></title>
<link rel="icon" href="<%= u('assets/img/favicon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%= u('assets/css/admin.css') %>?v=<%= v %>">
<link rel="stylesheet" href="<%= u('assets/css/main.css') %>?v=<%= v %>">
<link rel="stylesheet" href="<%= u('assets/css/code.css') %>?v=<%= v %>">
<link rel="stylesheet" href="<%= u('admin/vendor/katex.min.css') %>?v=<%= v %>">
<script>
(function(){try{var t=localStorage.getItem('theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
</script>
</head>
<body class="admin-body">

<!-- ============ 登录 ============ -->
<section class="admin-login" id="loginView">
  <form class="login-card" id="loginForm">
    <div class="brand">
      <div class="brand-icon">&Sigma;</div>
      <h1 class="login-title"><%= site.title %></h1>
      <p class="login-subtitle">后台管理</p>
    </div>

    <p class="login-desc">请输入管理口令与 GitHub Token。Token 仅保存在当前浏览器，不会上传任何服务器。</p>

    <label class="field">
      <span>管理口令</span>
      <input type="password" id="passInput" placeholder="你设置的口令" autocomplete="current-password" required>
    </label>

    <label class="field token-field">
      <span>GitHub Token（PAT）</span>
      <input type="password" id="tokenInput" placeholder="ghp_..." autocomplete="off" required>
      <button type="button" class="token-toggle" id="tokenToggle" tabindex="-1">显示</button>
    </label>

    <label class="checkbox">
      <input type="checkbox" id="remember" checked> 信任此电脑 30 天（Token 仅在本浏览器保存 30 天；过期、失效或主动退出时自动清除。公用电脑请取消勾选）
    </label>

    <button class="btn primary block" type="submit" id="loginBtn">进入后台</button>

    <p class="login-error" id="loginError" hidden></p>

    <div class="login-log" id="loginLog"></div>

    <div class="login-diag">
      <button type="button" class="btn ghost sm block" id="testTokenBtn">仅测试 Token 连通性（不校验口令）</button>
      <pre class="login-test" id="testResult" hidden></pre>
    </div>

    <details class="login-help">
      <summary>怎么拿到 GitHub Token？</summary>
      <ol>
        <li>打开 <a href="https://github.com/settings/tokens/new" target="_blank" rel="noopener">github.com/settings/tokens/new</a></li>
        <li>选择 <strong>Classic token</strong>，Expiration 选 90 天</li>
        <li>勾选 <strong>repo</strong>（完整仓库读写）</li>
        <li>点 Generate，复制 <code>ghp_...</code> 粘贴到上方</li>
      </ol>
      <p class="warn">⚠️ Token 等同于仓库写权限。若泄露，请立刻到 GitHub 设置页 Revoke。</p>
      <p class="warn">⚠️ Edge 浏览器「跟踪防护」可能拦截 api.github.com：<code>edge://settings/privacy</code> → 跟踪防护 → 选「基本」或在「例外」添加 <code>api.github.com</code>、<code>clouderdream.github.io</code>。</p>
    </details>

    <p class="login-back"><a href="<%= u('/') %>">← 返回站点</a></p>
    <p class="login-version">构建版本 <%= v %></p>
  </form>
</section>

<!-- ============ 后台主体 ============ -->
<section class="admin-app" id="appView" hidden>
  <aside class="admin-side" id="appSide">
    <div class="admin-side-head">
      <strong id="sideTitle">文章列表</strong>
      <button class="btn sm" id="newBtn" type="button">＋ 新建</button>
    </div>
    <p class="admin-side-meta" id="sideMeta"></p>
    <div class="admin-search" id="sideSearch">
      <input type="search" id="listSearch" placeholder="搜索文章…" autocomplete="off">
    </div>
    <ul class="admin-list" id="postList"><li class="empty">加载中…</li></ul>
    <div class="admin-side-foot">
      <p class="admin-trust" id="trustInfo" hidden></p>
      <button class="btn sm ghost block" id="logoutBtn" type="button">退出并清除 Token</button>
    </div>
  </aside>

  <header class="admin-header">
    <h2 id="headerTitle">文章管理</h2>
    <div class="tabs">
      <button class="tab active" data-tab="articles">文章</button>
      <button class="tab" data-tab="pages">页面</button>
      <button class="tab" data-tab="media">媒体库</button>
      <button class="tab" data-tab="settings">站点设置</button>
    </div>
  </header>

  <main class="admin-main" id="mainArea">
    <!-- 文章管理 -->
    <div id="tab-articles">
      <div class="admin-toolbar">
        <input class="title-input" id="fTitle" placeholder="文章标题" autocomplete="off">
        <button class="btn primary" id="saveBtn" type="button">保存并发布</button>
        <button class="btn ghost" id="saveDraftBtn" type="button">存草稿</button>
        <button class="btn danger" id="deleteBtn" type="button">删除</button>
      </div>

      <!-- 基础信息分组 -->
      <fieldset class="meta-group">
        <legend>基础信息</legend>
        <div class="meta-row">
          <label class="field field-grow">
            <span>日期</span>
            <input id="fDate" type="date">
          </label>
          <label class="field field-grow">
            <span>slug（URL）</span>
            <input id="fSlug" placeholder="limit-and-derivative" autocomplete="off">
            <small class="field-hint">英文、数字、连字符；留空则按日期与标题生成</small>
          </label>
          <label class="field field-toggle">
            <span>草稿</span>
            <label class="switch"><input type="checkbox" id="fDraft"><span class="switch-slider"></span></label>
          </label>
        </div>
        <label class="field">
          <span>摘要（列表与 SEO 描述）</span>
          <textarea id="fSummary" rows="2" placeholder="一句话概括这篇文章（≤120 字）"></textarea>
        </label>
      </fieldset>

      <fieldset class="meta-group">
        <legend>媒体与标签</legend>
        <label class="field">
          <span>顶部图片（cover）</span>
          <div class="row-flex">
            <input type="text" id="fCover" placeholder="images/xxx.jpg 或留空">
            <button class="btn ghost sm" id="pickCoverBtn" type="button">从媒体库选</button>
            <button class="btn ghost sm" id="clearCoverBtn" type="button">清除</button>
          </div>
          <small class="field-hint">支持 jpg/png/svg，存放在 <code>v1.2/content/images/</code>，使用相对路径 <code>images/xxx.jpg</code> 引用</small>
        </label>

        <label class="field">
          <span>标签</span>
          <div class="tag-box" id="tagBox">
            <input type="text" id="tagInput" placeholder="输入后回车添加，或点下方建议" autocomplete="off">
          </div>
          <div class="tag-suggestions" id="tagSuggestions" data-empty="暂无建议标签——先写几篇文章再回来就有了 :)"></div>
        </label>
      </fieldset>

      <!-- 常用符号工具栏（蓝色框区域） -->
      <div class="symbol-bar" id="symbolBar" role="toolbar" aria-label="常用符号">
        <span class="symbol-label">常用符号</span>
        <button type="button" class="sym" data-insert="∑" data-wrap="_{ }^{ }" title="求和 ∑">∑</button>
        <button type="button" class="sym" data-insert="∫" data-wrap="_{ }^{ }" title="积分 ∫">∫</button>
        <button type="button" class="sym" data-insert="∏" data-wrap="_{ }^{ }" title="连乘 ∏">∏</button>
        <button type="button" class="sym" data-insert="√" data-wrap="{}" title="根号 √">√</button>
        <button type="button" class="sym" data-insert="\frac" data-wrap="{}{}" title="分数">a⁄b</button>
        <button type="button" class="sym" data-insert="\partial" data-wrap="" title="偏导 ∂">∂</button>
        <button type="button" class="sym" data-insert="\nabla" data-wrap="" title="梯度 ∇">∇</button>
        <button type="button" class="sym" data-insert="\infty" data-wrap="" title="无穷 ∞">∞</button>
        <button type="button" class="sym" data-insert="\to" data-wrap="" title="→">→</button>
        <button type="button" class="sym" data-insert="\Rightarrow" data-wrap="" title="⇒">⇒</button>
        <button type="button" class="sym" data-insert="\Leftrightarrow" data-wrap="" title="⇔">⇔</button>
        <button type="button" class="sym" data-insert="\le" data-wrap="" title="≤">≤</button>
        <button type="button" class="sym" data-insert="\ge" data-wrap="" title="≥">≥</button>
        <button type="button" class="sym" data-insert="\neq" data-wrap="" title="≠">≠</button>
        <button type="button" class="sym" data-insert="\approx" data-wrap="" title="≈">≈</button>
        <button type="button" class="sym" data-insert="\pm" data-wrap="" title="±">±</button>
        <button type="button" class="sym" data-insert="\times" data-wrap="" title="×">×</button>
        <button type="button" class="sym" data-insert="\div" data-wrap="" title="÷">÷</button>
        <button type="button" class="sym" data-insert="\cdot" data-wrap="" title="·">·</button>
        <button type="button" class="sym" data-insert="\alpha" data-wrap="" title="α">α</button>
        <button type="button" class="sym" data-insert="\beta" data-wrap="" title="β">β</button>
        <button type="button" class="sym" data-insert="\gamma" data-wrap="" title="γ">γ</button>
        <button type="button" class="sym" data-insert="\delta" data-wrap="" title="δ">δ</button>
        <button type="button" class="sym" data-insert="\theta" data-wrap="" title="θ">θ</button>
        <button type="button" class="sym" data-insert="\lambda" data-wrap="" title="λ">λ</button>
        <button type="button" class="sym" data-insert="\mu" data-wrap="" title="μ">μ</button>
        <button type="button" class="sym" data-insert="\pi" data-wrap="" title="π">π</button>
        <button type="button" class="sym" data-insert="\sigma" data-wrap="" title="σ">σ</button>
        <button type="button" class="sym" data-insert="\phi" data-wrap="" title="φ">φ</button>
        <button type="button" class="sym" data-insert="\omega" data-wrap="" title="ω">ω</button>
        <button type="button" class="sym" data-insert="\hbar" data-wrap="" title="ℏ">ℏ</button>
        <span class="symbol-sep"></span>
        <button type="button" class="sym sym-action" id="inlineImageBtn" title="上传并插入正文图片">🖼️</button>
        <input type="file" id="inlineImageInput" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" hidden>
        <button type="button" class="sym sym-action" data-insert="$$" data-wrap="\n" title="行间公式块">$$…$$</button>
        <button type="button" class="sym sym-action" data-insert="$" data-wrap=" $ $ " title="行内公式">$…$</button>
        <button type="button" class="sym sym-action" data-insert="```\n" data-wrap="\n```" title="代码块">```</button>
        <button type="button" class="sym sym-action" data-insert="**" data-wrap="****" title="加粗"><b>B</b></button>
        <button type="button" class="sym sym-action" data-insert="*" data-wrap="**" title="斜体"><i>I</i></button>
        <button type="button" class="sym sym-action" data-insert="[" data-wrap="]()" title="链接">🔗</button>
        <button type="button" class="sym sym-action" data-insert="![" data-wrap="]()" title="图片">🖼</button>
      </div>

      <div class="editor-wrap">
        <div class="editor-pane">
          <div class="pane-head">Markdown 源码</div>
          <textarea id="fBody" spellcheck="false" placeholder="在此书写 Markdown。行内公式 $E=mc^2$，行间公式另起一行 $$ ... $$"></textarea>
        </div>
        <div class="editor-pane">
          <div class="pane-head">
            <span>实时预览</span>
            <button type="button" class="btn ghost sm" id="exportPdfBtn" title="导出当前文章为 PDF（通过浏览器打印对话框另存为 PDF）">导出 PDF</button>
          </div>
          <div class="preview" id="preview"></div>
        </div>
      </div>

      <p class="status" id="status"></p>
    </div>

    <!-- 媒体库 -->
    <div id="tab-media" hidden>
      <div class="admin-toolbar" style="margin-bottom:14px">
        <label class="btn primary" for="uploadInput">＋ 选择文件</label>
        <input type="file" id="uploadInput" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" multiple hidden>
        <span class="status" id="uploadStatus" style="margin:0"></span>
      </div>
      <div class="dropzone" id="dropzone">
        <div class="dropzone-inner">
          <div class="dropzone-icon">⬆</div>
          <div class="dropzone-text">把 jpg / png / webp / gif / svg <strong>拖到此处</strong> 上传，或点上方「选择文件」</div>
          <div class="dropzone-hint">支持多文件同时上传；最大 5MB/张（GitHub Contents API 限制）</div>
        </div>
      </div>
      <div class="media-grid" id="mediaGrid"><div class="empty">加载中…</div></div>
    </div>

    <!-- 站点设置 -->
    <div id="tab-settings" hidden>
      <form class="settings-form" id="settingsForm">
        <div class="admin-toolbar" style="margin-bottom:18px">
          <h3 style="margin:0">站点设置</h3>
          <button class="btn primary" type="submit" id="saveSettingsBtn">保存设置</button>
        </div>

        <label class="field"><span>站点标题</span><input type="text" id="sTitle" required></label>
        <label class="field"><span>副标题</span><input type="text" id="sSubtitle"></label>
        <label class="field"><span>站点描述（SEO）</span><textarea id="sDesc"></textarea></label>
        <label class="field"><span>作者</span><input type="text" id="sAuthor"></label>
        <label class="field"><span>版权信息</span><input type="text" id="sCopyright"></label>
        <label class="field">
          <span>全站顶部 Banner（留空为纯色标题栏）</span>
          <div style="display:flex;gap:8px">
            <input type="text" id="sBanner" placeholder="images/banner.jpg" style="flex:1">
            <button class="btn ghost sm" id="pickBannerBtn" type="button">从媒体库选</button>
          </div>
        </label>

        <label class="field"><span>导航菜单（JSON）</span><textarea id="sNav" rows="6"></textarea></label>
        <label class="field"><span>社交链接（JSON）</span><textarea id="sSocial" rows="6"></textarea></label>

        <p class="status" id="settingsStatus"></p>
      </form>
    </div>
  </main>
</section>

<script src="<%= u('admin/vendor/markdown-it.min.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/vendor/katex.min.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/vendor/md-math.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/config.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/github.js') %>?v=<%= v %>"></script>
<script src="<%= u('admin/admin.js') %>?v=<%= v %>"></script>
</body>
</html>
