<%- include('partials/head', { pageTitle: pageTitle, pageDesc: pageDesc, canonical: canonical, lang: lang, site: site, cfg: cfg, u: u, v: v, ogType: 'website' }) %>
<%- include('partials/nav', { site: site, cfg: cfg, u: u, v: v, currentPath: currentPath, recentPosts: sidebar.recentPosts, topTags: sidebar.topTags, archiveMonths: sidebar.archiveMonths }) %>

<section class="hero">
  <div class="wrap">
    <div class="kicker">科研前沿 · DAILY RESEARCH BRIEFING</div>
    <h1>每天五条，追踪值得继续研究的问题。</h1>
    <p class="lede">聚焦论文选题、方法创新与新趋势。每条简报保留“发生了什么、为什么重要、值得继续追什么”三层信息，并附可核验来源。</p>
  </div>
</section>

<div class="layout">
  <main id="main">
    <% if (isFirst && featured) { %>
      <article class="featured">
        <span class="tag">最新一期 · <%= featured.date %></span>
        <h2><a href="<%= featured.url %>"><%= featured.title %></a></h2>
        <p class="excerpt"><%= featured.summary %></p>
        <div class="meta">
          <span>约 <%= featured.readingTime %> 分钟</span><span>·</span><span><%= featured.tags.join(' / ') %></span>
        </div>
      </article>
    <% } else if (isFirst && !featured) { %>
      <article class="featured">
        <span class="tag">栏目已就绪</span>
        <h2>第一期将在下一次每日简报完成后自动发布。</h2>
        <p class="excerpt">自动任务会把当天简报写入网站文章并触发 GitHub Pages 更新。</p>
      </article>
    <% } %>

    <div class="sec-head">
      <h3><%= isFirst ? '往期简报' : ('科研前沿 · 第 ' + pager.current + ' 页') %></h3>
      <a href="<%= u('tags/科研前沿/') %>">查看标签归档 →</a>
    </div>

    <% if (!listPosts.length && !featured) { %>
      <p class="empty">还没有简报。</p>
    <% } %>

    <% listPosts.forEach(function (post, i) { %>
      <article class="post">
        <div class="num"><%= String(i + 1).padStart(2, '0') %></div>
        <div class="post-main">
          <div class="cat"><%= post.date %></div>
          <h4><a href="<%= post.url %>"><%= post.title %></a></h4>
          <p class="exc"><%= post.summary %></p>
          <div class="meta"><span>约 <%= post.readingTime %> 分钟</span><span>·</span><span>科研前沿 / 每日简报</span></div>
        </div>
      </article>
    <% }); %>

    <%- include('partials/pagination', { pager: pager }) %>
  </main>

  <%- include('partials/sidebar', { site: site, cfg: cfg, u: u, v: v, recentPosts: sidebar.recentPosts, topTags: sidebar.topTags, archiveMonths: sidebar.archiveMonths }) %>
</div>

<%- include('partials/footer', { site: site, cfg: cfg, u: u, v: v }) %>
